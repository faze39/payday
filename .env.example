# Copy to .env.local and fill in. Every variable is optional for local development.

# NEAR Intents 1Click API partner key (JWT) from https://partners.near-intents.org.
# Sent as the X-API-Key header. Without it, the app still works, but 1Click charges a higher platform fee.
ONECLICK_API_KEY=

# Supabase (Project Settings → API). If unset, Payday uses a local JSON file (.data/), which is fine for dev only.
# The service-role key is server-only. Never expose it to the browser or commit it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional TESTNET invoice metadata after SUCCESS. This does not change mainnet payments.
# Never commit real keys. Freelancers do not need NEAR — the server relayer signs.
NEAR_INVOICE_CONTRACT_ID=payday-registry-1794060636.testnet
NEAR_RELAYER_ACCOUNT_ID=payday-registry-1794060636.testnet
NEAR_RELAYER_KEY=
NEAR_NETWORK=testnet

# Canonical public URL (agent invoice self-links). Defaults to request Host / payday-near.vercel.app.
NEXT_PUBLIC_APP_URL=
